{
  "name": "catalog-maker-platform",
  "version": "1.0.0",
  "description": "Catalog Maker: High-Speed Product Catalog Platform",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build && cd .. && node -e \"require('fs').cpSync('client/dist', 'dist', {recursive: true})\""
  },
  "keywords": [
    "catalog",
    "shopify",
    "woocommerce",
    "whatsapp-inquiry",
    "mobile-first"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
